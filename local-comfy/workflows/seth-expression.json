   ],
   "title": "STYLE LOCK \u2014 house style",
   "properties": {
    "Node name for S&R": "PrimitiveStringMultiline"
   },
   "widgets_values": [
    "Draw it in exactly the same style as image 1: a 1933 Fleischer-era rubber-hose cartoon posed with real weight and balance, confident smooth ink outlines of even weight, shaded only with soft halftone dots, warm sepia duotone on aged grey-brown newsprint, muted desaturated ink and no bright modern colour. The art fills the frame with no border and no margin. There are no speech balloons, no caption boxes, no lettering, no signature and no watermark."
   ],
   "color": "#223",
   "bgcolor": "#335"
  },
