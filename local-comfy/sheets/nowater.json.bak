 "tags": [
  {
   "name": "walk",
   "from": 0,
   "to": 9,
   "fps": 4,
   "direction": "forward",
   "loop": true,
   "hold_key": false,
   "unify": "head",
   "clip": "/tmp/nowater-walk-cycle-832-20.mp4",
   "recipe": "walk-cycle",
   "recipe_text": "a full walk cycle on the spot with his hands empty, as if walking on a treadmill: he strides steadily through contact, down, passing and up positions, his legs facing to the right, while his body stays in exactly the same place in the frame, and he ends on exactly the same pose he began with so the cycle loops seamlessly",
   "cells": 10,
   "cyclic": true
  },
  {
   "name": "idle",
   "from": 10,
   "to": 17,
   "fps": 8,
   "direction": "forward",
   "loop": true,
   "hold_key": false,
   "unify": true,
   "clip": "/tmp/nowater-idle-breathe-832-20.mp4",
   "recipe": "idle-breathe",
   "recipe_text": "a gentle idle: he stands square, breathing, weight shifting a little from one side to the other, and returns exactly to the pose he started in",
   "cells": 8,
   "cyclic": true
  },
  {
   "name": "punch",
   "from": 18,
   "to": 17,
   "fps": 16,
   "direction": "forward",
   "loop": false,
   "hold_key": false,
   "unify": false,
   "clip": "/tmp/nowater-punch-832-20.mp4",
   "recipe": "punch",
   "recipe_text": "he winds up, throws one straight punch out to the right, holds the extension a beat, and pulls the arm back to his guard",
   "cells": 8,
   "cyclic": false
  },
  {
   "name": "kick",
   "from": 18,
   "to": 17,
   "fps": 16,
   "direction": "forward",
   "loop": false,
   "hold_key": false,
   "unify": false,
   "clip": "/tmp/nowater-kick-832-20.mp4",
   "recipe": "kick",
   "recipe_text": "he plants one foot, swings the other leg up in a high kick to the right, holds the extension, and sets the foot back down",
   "cells": 8,
   "cyclic": false
  },
  {
   "name": "jump",
   "from": 18,
   "to": 17,
   "fps": 16,
   "direction": "forward",
   "loop": false,
   "hold_key": false,
   "unify": false,
   "clip": "/tmp/nowater-jump-832-20.mp4",
   "recipe": "jump",
   "recipe_text": "a standing jump: he crouches, springs up with arms rising, hangs at the top, and lands back on the ground line absorbing the impact",
   "cells": 8,
   "cyclic": false
  },
  {
   "name": "block",
   "from": 18,
   "to": 17,
   "fps": 16,
   "direction": "forward",
   "loop": false,
   "hold_key": true,
   "unify": false,
   "clip": "/tmp/nowater-block-832-20.mp4",
   "recipe": "block",
   "recipe_text": "he stands still on one spot with both feet planted flat on the ground and never takes a step, never walks and never moves across the screen; his hands are empty and his back stays straight and upright the whole time. Standing exactly where he is, he crosses both forearms up in front of his face and chest to shield himself, hunches his shoulders and tucks his head down behind his arms, holds that braced position, then lowers his arms back to his sides, his feet staying in the same place the whole time",
   "cells": 6,
   "cyclic": false
  },
  {
   "name": "crouch",
   "from": 18,
   "to": 17,
   "fps": 16,
   "direction": "forward",
   "loop": false,
   "hold_key": true,
   "unify": false,
   "clip": "/tmp/nowater-crouch-832-20.mp4",
   "recipe": "crouch",
   "recipe_text": "he ducks down into a low crouch, holds it a beat, and rises back to standing",
   "cells": 6,
   "cyclic": false
  }
 ],
